extends "res://tests/spatial/test_base.gd"
const TrackFactory=preload("res://scripts/track/track_factory.gd")
const Factory=preload("res://scripts/vehicle/drive_model_factory.gd")
const Router=preload("res://scripts/input/command_router.gd")
func _initialize()->void:
	call_deferred("run")
func run()->void:
	var old:Dictionary=TrackFactory.load_track("res://tracks/01_erste_fahrt.json")
	var fresh:Dictionary=TrackFactory.load_track("res://tests/fixtures/spatial/straight.json")
	var legacy=Factory.create(old.track);var spatial=Factory.create(fresh.track)
	check(legacy!=null and spatial!=null,"factory supports both formats")
	if spatial!=null:
		var router=Router.new(spatial);router.state="RUNNING";router.step(1.0/60.0)
		check(spatial.distance_m>0,"router drives spatial state")
		var snapshot:Dictionary=spatial.state.snapshot();router.state="PAUSED";router.step(1)
		check(spatial.state.snapshot()==snapshot,"pause freezes new physics")
		check(spatial.position==spatial.state.position and spatial.airborne==(spatial.state.mode=="airborne"),"UI fields describe actual state")
		check(not load("res://scripts/track/spatial/verification.gd").playable(fresh.track,spatial.spatial_profile),"missing report blocks release")
		router=null
	var scene=load("res://scenes/main.tscn").instantiate()
	scene.settings_path="/private/tmp/stuntcar-spatial-settings-%d.cfg"%OS.get_process_id()
	root.add_child(scene);scene.set_process(false);scene.set_physics_process(false)
	var path:="res://tracks/99_spatial_test_%d.json"%OS.get_process_id()
	var data:Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/spatial/straight.json"))
	data.report="reports/99_spatial_test_%d.json"%OS.get_process_id()
	var file:=FileAccess.open(path,FileAccess.WRITE);file.store_string(JSON.stringify(data));file.close()
	scene.select_track(path)
	check(scene.track.source_path!=path,"unverified route cannot replace active track")
	var loaded:Dictionary=TrackFactory.load_track(path)
	var Verification=load("res://scripts/track/spatial/verification.gd")
	var profile:Dictionary=load("res://scripts/vehicle/spatial/stunt_assist.gd").profile("very_easy")
	var inputs:Array[Dictionary]=[]
	var run_result:Dictionary=load("res://scripts/vehicle/spatial/drive_runner.gd").run(loaded.track,profile,inputs,200)
	check(run_result.finished,"fixture has a real successful drive")
	DirAccess.make_dir_recursive_absolute("res://tracks/reports")
	var report_path:String="res://tracks/"+data.report
	file=FileAccess.open(report_path,FileAccess.WRITE)
	file.store_string(JSON.stringify({"profiles":{"very_easy":{"digest":Verification.digest(loaded.track,profile),"clean_completed":run_result.finished}}}));file.close()
	scene.select_track(path)
	check(scene.track.source_path==path and scene.model.has_method("feedback_state"),"scene switches to spatial model")
	scene.session.restart();scene._physics_process(1.0/60.0)
	check(scene.model.distance_m>5,"scene advances spatial car")
	scene.session.state="PAUSED";var old_tick:int=scene.model.state.tick;scene._physics_process(1.0/60.0)
	check(scene.model.state.tick==old_tick,"scene pause does not move car")
	scene.save_settings()
	var restored=load("res://scenes/main.tscn").instantiate();restored.settings_path=scene.settings_path
	root.add_child(restored);restored.set_process(false);restored.set_physics_process(false)
	check(restored.track.source_path==path,"saved spatial selection restored")
	restored.queue_free()
	scene.select_track("res://tracks/01_erste_fahrt.json")
	check(not scene.model.has_method("feedback_state"),"switch back restores legacy model")
	DirAccess.remove_absolute(scene.settings_path);scene.queue_free();await process_frame
	DirAccess.remove_absolute(path);DirAccess.remove_absolute(report_path)
	done()
