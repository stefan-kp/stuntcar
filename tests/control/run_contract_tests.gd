extends "res://tests/control/test_base.gd"
const F = preload("res://tests/control/fixtures.gd")
func _initialize() -> void:
 var C = need("res://addons/accessible_controls/core/contract.gd")
 var S = need("res://addons/accessible_controls/core/input_source.gd")
 var P = need("res://addons/accessible_controls/core/game_port.gd")
 if C==null or S==null or P==null:done();return
 check(C.validate_catalog(F.catalog()).is_empty(),"valid catalogue")
 check(C.validate_intent(F.intent(),F.catalog()).is_empty(),"valid intent")
 check(not C.validate_intent(F.intent({"schema_version":2}),F.catalog()).is_empty(),"test_bad_version")
 check(not C.validate_intent(F.intent({"required_actions":[F.action("missing")]}),F.catalog()).is_empty(),"test_unknown_action")
 check(not C.validate_assessment(F.assessment({"utility":INF}),F.catalog()).is_empty(),"test_nonfinite_utility")
 check(not C.validate_assessment(F.assessment({"rating_status":"unknown","utility":0.0}),F.catalog()).is_empty(),"test_unknown_has_null_utility")
 check(C.validate_assessment(F.assessment({"rating_status":"unknown","utility":null}),F.catalog()).is_empty(),"unknown null accepted")
 check(not C.validate_intent(F.intent({"required_actions":[F.action("turn_left"),F.action("turn_right")]}),F.catalog()).is_empty(),"test_atomic_request_shape conflicting")
 check(C.validate_intent(F.intent({"required_actions":[F.action("turn_left"),F.action("brake",100)]}),F.catalog()).is_empty(),"test_atomic_request_shape independent")
 var source = S.new("keys")
 var first = source.begin("s1","explicit",[F.action("brake",100)],0,250)
 var update = source.update(first.control_id,[F.action("brake",100)],50,250)
 var ending = source.end(first.control_id,100,250)
 check(first.control_revision==1 and update.control_revision==2 and ending.control_revision==3,"test_source_revisions")
 check(first.event_id!=update.event_id and first.control_id==update.control_id,"source event identities")
 source.reset()
 check(source.begin("s1","explicit",[F.action("brake",100)],150,250).control_id!=first.control_id,"reset never reuses control id")
 check(C.validate_intent(ending,F.catalog()).is_empty(),"end accepts empty action list")
 done()
