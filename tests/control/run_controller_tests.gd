extends "res://tests/control/test_base.gd"
const F = preload("res://tests/control/fixtures.gd")
const Port = preload("res://tests/control/fake_game_port.gd")
func _initialize() -> void:
 var S = need("res://addons/accessible_controls/core/selector.gd")
 var L = need("res://addons/accessible_controls/core/input_ledger.gd")
 var C = need("res://addons/accessible_controls/core/controller.gd")
 if S==null or L==null or C==null:done();return
 var left = F.intent()
 var answer = F.assessment({}, {"proposals":[F.proposal("right",[F.action("turn_right")],0.9),F.proposal("left",[F.action("turn_left")],-0.8)]})
 check(S.choose(left,answer,F.profile()).actions==left.required_actions,"test_explicit_left_beats_better_right")
 answer.proposals.append(F.proposal("left_brake",[F.action("turn_left"),F.action("brake",100)],0.8))
 check(S.choose(left,answer,F.profile("easy")).actions.size()==2,"test_easy_addition")
 check(S.choose(left,answer,F.profile("direct")).actions.size()==1,"test_direct_has_no_addition")
 var call = F.intent({"kind":"activate","required_actions":[]})
 check(S.choose(call,answer,F.profile("easy")).status=="no_action","test_activate_only_very_easy")
 check(S.choose(call,answer,F.profile()).actions[0].action_id=="turn_right","activate picks best")
 answer.proposals=[F.proposal("open",[F.action("turn_left")],null,"unknown","open"),F.proposal("crash",[F.action("turn_left"),F.action("brake",100)],-0.9,"rated","crashed")]
 check(S.choose(left,answer,F.profile()).status=="explicit_only","test_open_without_addition_vs_crashed_addition")
 check(S.choose(call,answer,F.profile()).status=="no_action","open call never chooses known crash")
 check(S.choose(left,F.assessment({"rating_status":"unknown","utility":null}),F.profile()).status=="explicit_only","test_missing_rating_uses_explicit_only")
 answer.proposals=[F.proposal("unknown",[F.action("turn_right")],null,"unknown"),F.proposal("negative",[F.action("turn_left")],-0.8)]
 check(S.choose(call,answer,F.profile()).actions[0].action_id=="turn_left","test_unknown_is_not_zero")
 var ledger = L.new();ledger.reset("s1")
 var begin = F.intent({"required_actions":[F.action("brake",100)]})
 check(ledger.accept(begin,0).status=="accepted","ledger begin")
 check(ledger.accept(F.intent({"event_id":"u3","control_revision":3,"phase":"update","required_actions":[F.action("brake",100)],"captured_at_ms":50}),50).status=="accepted","new revision accepted")
 check(ledger.accept(F.intent({"event_id":"u2","control_revision":2,"phase":"update","required_actions":[F.action("brake",100)]}),50).status=="stale","test_old_revision_after_newer_update")
 check(ledger.accept(F.intent({"event_id":"end","control_revision":4,"phase":"end","required_actions":[],"captured_at_ms":60}),60).status=="accepted","end accepted")
 check(ledger.accept(F.intent({"event_id":"u5","control_revision":5,"phase":"update","required_actions":[F.action("brake",100)]}),70).status=="stale","test_update_after_end")
 ledger.reset("s1");ledger.accept(begin,0);ledger.retire_members(begin.control_id,["brake"])
 check(ledger.accept(F.intent({"event_id":"u2","control_revision":2,"phase":"update","required_actions":[F.action("brake",100)]}),50).status=="stale","test_update_after_replacement")
 ledger.reset("s1");ledger.accept(F.intent({"required_actions":[F.action("brake",100),F.action("turn_left")]}),0);ledger.retire_members("key:1",["turn_left"])
 var partial = ledger.accept(F.intent({"event_id":"partial","control_revision":2,"phase":"update","required_actions":[F.action("brake",100)]}),50)
 check(partial.status=="accepted" and partial.intent.required_actions.size()==1,"test_opposite_keeps_other_member")
 var port=Port.new();var controller=C.new(port,F.profile());controller.begin_session("s1")
 controller.submit(left);controller.submit(left);controller.step(0)
 check(port.position==-1 and port.applied.size()==1,"test_duplicate_impulse")
 controller.submit(F.intent({"event_id":"expired","control_id":"expired","expires_at_ms":1}));controller.step(20)
 check(port.position==-1,"test_expired_event")
 controller.submit(F.intent({"session_id":"other","event_id":"other","control_id":"other"}));controller.step(20)
 check(port.position==-1,"test_foreign_session")
 var before=port.applied.size();controller.read_hints(20)
 check(port.applied.size()==before,"test_read_hints_never_applies")
 controller.submit(F.intent({"event_id":"pair","control_id":"pair","required_actions":[F.action("turn_left"),F.action("brake",100)]}))
 controller.submit(F.intent({"event_id":"right","control_id":"right","required_actions":[F.action("turn_right")]}));controller.step(20)
 check(port.applied.size()==before,"test_conflicting_pair_has_no_partial_start and test_same_step_opposites")
 controller.suspend("pause",30)
 check(port.cancelled[-1].scope=="session","test_suspend_cancels_all")
 controller.submit(F.intent({"event_id":"paused","control_id":"paused","captured_at_ms":40}));controller.step(40)
 check(port.applied.size()==before,"test_no_action_while_suspended")
 controller.begin_session("s1");controller.submit(left);controller.step(40)
 check(port.applied.size()==before,"test_same_session_resume_retains_seen_inputs")
 controller.lose_source("voice",40)
 check(port.cancelled[-1].source_id=="voice","test_cancel_one_source")
 var retry_port=Port.new();retry_port.stale_count=2
 var retry=C.new(retry_port,F.profile());retry.begin_session("s1");retry.submit(left);retry.step(0)
 check(retry_port.position==-1 and retry_port.applied.size()==1,"two stale assessments fall back to original action once")
 done()
